# Voice QA Engine 环境配置示例
# 复制为 .env 并填入对应凭据，严禁提交真实 .env 至版本控制

# 语音算法服务地址
VOICE_QA_BASE_URL=https://lingxinai.com

# 自动化测试专属账号（请从安全凭据管理器获取）
VOICE_QA_USERNAME=your_username
VOICE_QA_PASSWORD=your_password

# MOSS-Live 实时全双工服务接入配置 (V1.2 引入)
MOSS_LIVE_WS_URL=wss://api.mosi.cn/v1/realtime
MOSS_LIVE_API_KEY=your_moss_api_key
